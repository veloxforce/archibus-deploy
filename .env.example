# =============================================================================
# FM Assistant Environment Variables
# =============================================================================

# --- Environment identity ---
# COMPOSE_PROJECT_NAME: this environment's name. It prefixes the containers,
# volumes and network (e.g. fm-assistant-pre-api-1), so several environments
# can run on one host. Running more than one? See README section 4c FIRST —
# on an existing install this value must match the directory name Compose has
# been using, or the stack starts against empty volumes.
COMPOSE_PROJECT_NAME=fm-assistant

# --- Port Overrides ---
# API_PORT: host port the FM Assistant UI is published on. The ONLY port
# published to the host — every other service is internal to this project's
# network, so identical internal ports never clash between environments.
# (docker-compose.yml maps ${API_PORT}:3080). Change it if 3080 is taken on the host.
API_PORT=3080
# FASTMCP_PORT=8000

# --- LibreChat ---
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
# Set these to the client's own host (scheme + host + published port).
# The default suits a local / single-host deploy reached at http://localhost:${API_PORT}.
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# Allow the first user to self-register through the shipped /register path.
ALLOW_REGISTRATION=true

# --- Bruce sign-in (required for the Bruce BEM iframe) ---
# The Bruce iframe opens the chat with ?userToken=...&refreshToken=... on the URL.
# The browser posts that token to /api/auth/bruce; LibreChat asks archibus_fastmcp
# (BRUCE_TOKEN_VALIDATE_URL) to check it against Bruce, and only a token Bruce
# accepts opens a session. No token, or a token Bruce rejects, gets the normal
# login form -- the chat URL alone no longer lets anyone in.
#
# Every Bruce user is signed in as ONE shared service account, named by
# AUTO_LOGIN_EMAIL. The account must exist in THIS deployment's own database:
# create it once via the /register path above (any strong password -- it is never
# put in this file and never sent to the browser), set AUTO_LOGIN_EMAIL to its
# email, then set ALLOW_REGISTRATION=false.
AUTO_LOGIN_ENABLED=true
AUTO_LOGIN_EMAIL=
# AUTO_LOGIN_PASSWORD is no longer used -- delete it from existing .env files.

# Where LibreChat checks a Bruce token. The default is archibus_fastmcp on this
# project's internal network; it is never published to the host.
BRUCE_TOKEN_VALIDATE_URL=http://archibus_fastmcp:8000/auth/validate

# Which sites may show the FM Assistant in an iframe (space-separated origins,
# scheme + host). Sent as "Content-Security-Policy: frame-ancestors ..." on every
# response; any other site that tries to frame it gets a blank frame. Leave empty
# only for a deploy that is never embedded -- then no framing restriction is sent.
ALLOWED_FRAME_ANCESTORS=https://spro-sp.bruceplatform.com

# --- Search (Meilisearch) ---
SEARCH=true
MEILI_MASTER_KEY=

# --- RAG ---
RAG_PORT=8000
# Must be a valid EmbeddingsProvider (empty crash-loops rag_api on
# "ValueError: '' is not a valid EmbeddingsProvider"). Default uses OPENAI_API_KEY below.
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Vector Database (PostgreSQL + pgvector) ---
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=

# --- AI Provider Keys ---
OPENAI_API_KEY=user_provided
ANTHROPIC_API_KEY=user_provided
RUNPOD_API_KEY=
OPENROUTER_KEY=

# --- BruceBEM API (FastMCP) ---
# Names must match what src/api.py reads via os.getenv (do NOT rename).
# Provision via Rein Suurvali (Auth0 M2M client + BEM API URLs).
# archibus_fastmcp also uses OAUTH_* + BEM_API_URL to check Bruce sign-in tokens
# for LibreChat (GET /auth/validate, see "Bruce sign-in" above): if these are wrong,
# nobody can sign in from the iframe.
OAUTH_CLIENT_ID=
CLIENT_SECRET=
OAUTH_URL=
AUDIENCE=
USER_API_CLIENT_ID=
# BEM_API_URL / USER_AUTH_URL: full URL incl. https:// and trailing /api/
# e.g. https://services.bruceplatform.com/api/  and  https://userauth.bruceplatform.com/api/
BEM_API_URL=
USER_AUTH_URL=

# --- Standalone / staging auth (STAGING_MODE) ---
# Default deploys expect a Rain user-token forwarded from the Bruce BEM iframe.
# For a standalone deploy with no iframe, set STAGING_MODE=true and fill USERNAME/PASSWORD;
# archibus_fastmcp then authenticates directly with these BEM credentials instead of the
# Rain token. See README "Standalone (STAGING_MODE) deployment" and docker-compose.staging.yml.
STAGING_MODE=false
USERNAME=
PASSWORD=
GRANT_TYPE=client_credentials
