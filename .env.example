# =============================================================================
# FM Assistant Environment Variables
# =============================================================================

# --- Port Overrides (default: 0 = Docker auto-assigns) ---
# API_PORT=3080
# FASTMCP_PORT=8000

# --- LibreChat ---
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
DOMAIN_CLIENT=https://archibus-fm-assistant.wilsch-deployment.com
DOMAIN_SERVER=https://archibus-fm-assistant.wilsch-deployment.com

# --- Search (Meilisearch) ---
SEARCH=true
MEILI_MASTER_KEY=

# --- RAG ---
RAG_PORT=8000
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=

# --- Vector Database (PostgreSQL + pgvector) ---
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=

# --- AI Provider Keys ---
OPENAI_API_KEY=user_provided
ANTHROPIC_API_KEY=user_provided
RUNPOD_API_KEY=
OPENROUTER_KEY=

# --- BruceBEM API (FastMCP) ---
# Names must match what src/api.py reads via os.getenv (do NOT rename).
# Provision via Rein Suurvali (Auth0 M2M client + BEM API URLs).
OAUTH_CLIENT_ID=
CLIENT_SECRET=
OAUTH_URL=
AUDIENCE=
USER_API_CLIENT_ID=
# BEM_API_URL / USER_AUTH_URL: full URL incl. https:// and trailing /api/
# e.g. https://services.bruceplatform.com/api/  and  https://userauth.bruceplatform.com/api/
BEM_API_URL=
USER_AUTH_URL=
USERNAME=
PASSWORD=
GRANT_TYPE=client_credentials
