# Rain Auth Token Passthrough — Custom LibreChat Image
# Builds from LibreChat source (v0.8.4) with Rain auth patches applied before compilation.
# Mirrors the official Dockerfile exactly — patches are overlaid on source before npm ci/build.
# Previous approach (overlaying on pre-built image + npm install after npm prune) corrupted
# workspace deps and caused container crash on startup.

# --- Stage 1: Fetch LibreChat source ---
FROM alpine:3.21 AS source
ADD https://github.com/danny-avila/LibreChat/archive/refs/tags/v0.8.4.tar.gz /tmp/librechat.tar.gz
RUN mkdir /src && tar xzf /tmp/librechat.tar.gz -C /src --strip-components=1

# --- Stage 2: Build (mirrors official LibreChat Dockerfile) ---
FROM node:20-alpine AS node

RUN apk upgrade --no-cache
RUN apk add --no-cache jemalloc
RUN apk add --no-cache python3 py3-pip uv

ENV LD_PRELOAD=/usr/lib/libjemalloc.so.2

COPY --from=ghcr.io/astral-sh/uv:0.9.5-python3.12-alpine /usr/local/bin/uv /usr/local/bin/uvx /bin/
RUN uv --version

ARG NODE_MAX_OLD_SPACE_SIZE=6144

RUN mkdir -p /app && chown node:node /app
WORKDIR /app

USER node

# Copy package files first for Docker layer caching
COPY --from=source --chown=node:node /src/package.json /src/package-lock.json ./
COPY --from=source --chown=node:node /src/api/package.json ./api/package.json
COPY --from=source --chown=node:node /src/client/package.json ./client/package.json
COPY --from=source --chown=node:node /src/packages/data-provider/package.json ./packages/data-provider/package.json
COPY --from=source --chown=node:node /src/packages/data-schemas/package.json ./packages/data-schemas/package.json
COPY --from=source --chown=node:node /src/packages/api/package.json ./packages/api/package.json

RUN \
    touch .env ; \
    mkdir -p /app/client/public/images /app/logs /app/uploads ; \
    npm config set fetch-retry-maxtimeout 600000 ; \
    npm config set fetch-retries 5 ; \
    npm config set fetch-retry-mintimeout 15000 ; \
    npm ci --no-audit

# Copy full source
COPY --from=source --chown=node:node /src .

# Apply Rain auth patches AFTER source copy, BEFORE build
# Server-side (Node.js runtime)
COPY --chown=node:node librechat-patches/packages/api/src/utils/env.ts packages/api/src/utils/env.ts
COPY --chown=node:node librechat-patches/api/server/controllers/agents/client.js api/server/controllers/agents/client.js
COPY --chown=node:node librechat-patches/api/server/services/MCP.js api/server/services/MCP.js
COPY --chown=node:node librechat-patches/api/server/routes/config.js api/server/routes/config.js

# Bruce agent seed script (run once by the init-bruce-agent service in docker-compose.yml)
COPY --chown=node:node librechat-patches/config/seed-bruce-agent.js config/seed-bruce-agent.js

# Shared packages (TypeScript, compiled during build)
COPY --chown=node:node librechat-patches/packages/data-provider/src/config.ts packages/data-provider/src/config.ts
COPY --chown=node:node librechat-patches/packages/data-provider/src/createPayload.ts packages/data-provider/src/createPayload.ts
COPY --chown=node:node librechat-patches/packages/data-provider/src/types.ts packages/data-provider/src/types.ts

# Client-side (React, bundled during build)
COPY --chown=node:node librechat-patches/client/src/App.jsx client/src/App.jsx
COPY --chown=node:node librechat-patches/client/src/components/Auth/Login.tsx client/src/components/Auth/Login.tsx
COPY --chown=node:node librechat-patches/client/src/hooks/Chat/useChatFunctions.ts client/src/hooks/Chat/useChatFunctions.ts

# Build frontend with patches, then prune for production
RUN \
    NODE_OPTIONS="--max-old-space-size=${NODE_MAX_OLD_SPACE_SIZE}" npm run frontend; \
    npm prune --production; \
    npm cache clean --force

EXPOSE 3080
ENV HOST=0.0.0.0
CMD ["npm", "run", "backend"]
